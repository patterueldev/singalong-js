# Production Environment Configuration
NODE_ENV=production
PORT=3000

# MongoDB (production database - use secure credentials)
MONGODB_URI=mongodb://admin:CHANGE_ME@mongodb:27017/singalong?authSource=admin
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME

# MinIO (production bucket - use secure credentials)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=singalong

# Default Admin (CHANGE THESE IN PRODUCTION)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME

# External APIs (replace with your actual production keys)
MEDIA_PROVIDER_API_KEY=
OPENAI_API_KEY=

# Data paths (production uses host paths, not docker volumes)
MONGODB_DATA_PATH=/var/lib/singalong/mongodb
MINIO_DATA_PATH=/var/lib/singalong/minio
