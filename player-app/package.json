{
  "name": "singalong-player-app",
  "version": "0.1.0",
  "description": "Player app for Singalong karaoke system - web, iOS, Android, tvOS, macOS, Windows",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "eject": "expo eject",
    "build:web": "expo export --platform web",
    "lint": "eslint . --ext .tsx,.ts"
  },
  "dependencies": {
    "expo": "^49.0.0",
    "expo-video": "^13.2.0",
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "react-native-web": "^0.18.0",
    "react-native-windows": "^0.72.0",
    "react-native-macos": "^0.72.0",
    "react-native-tvos": "^0.72.0",
    "singalong-shared": "workspace:*",
    "singalong-ui-library": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.2.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "@types/node": "^20.5.0",
    "eslint": "^8.48.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0"
  }
}
