# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MediaProvider API Keys
MEDIA_PROVIDER_API_KEY=
OPENAI_API_KEY=

# Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=

# App Configuration
NODE_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:3000

# Default Admin User (created on first run)
DEFAULT_ADMIN_USERNAME=sampleadmin
DEFAULT_ADMIN_PASSWORD=samplepassword

# Data Storage Paths (physical folders instead of Docker volumes)
MONGODB_DATA_PATH=./data/mongodb
MINIO_DATA_PATH=./data/minio
